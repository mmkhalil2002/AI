#===========================================================================
# Network Capture Configuration
#===========================================================================

# INTERFACE
# Network interface used for packet capture.
# Examples:
#   Windows : Ethernet, Wi-Fi
#   Linux   : eth0, ens33, wlan0
INTERFACE=Ethernet

# CAPTURE_FILTER
# Berkeley Packet Filter (BPF) expression.
# Examples:
#   tcp
#   udp
#   tcp or udp
#   port 443
#   host 192.168.1.100
CAPTURE_FILTER=tcp or udp

# PACKET_COUNT
# Maximum packets to capture.
# 0 = Capture continuously until stopped.
PACKET_COUNT=0

# TIMEOUT
# Maximum capture duration in seconds.
# 0 = Unlimited capture time.
TIMEOUT=60

#===========================================================================
# Output Files
#===========================================================================

# PCAP_FILE
# Raw packet capture readable by Wireshark.
PCAP_FILE=capture.pcap

# CSV_FILE
# Decoded packet information in CSV format.
CSV_FILE=capture.csv

# JSON_FILE
# Optional JSON export for AI/ML or databases.
JSON_FILE=capture.json

#===========================================================================
# Local IP Addresses
#===========================================================================

# LOCAL_IPS
# Comma-separated list of local IP addresses.
# Used to determine upload/download direction.
LOCAL_IPS=192.168.1.25,10.10.10.5

#===========================================================================
# Payload Collection
#===========================================================================

# PAYLOAD_PREVIEW_BYTES
# Number of payload bytes to save.
# 0 = Disabled.
PAYLOAD_PREVIEW_BYTES=0

# STORE_RAW_PAYLOAD
# True  = Store complete payload.
# False = Do not store payload (recommended for privacy).
STORE_RAW_PAYLOAD=False

#===========================================================================
# Display
#===========================================================================

# Print every captured packet.
PRINT_EVERY_PACKET=True

# Print final capture statistics.
PRINT_CAPTURE_SUMMARY=True

# Print parser/runtime errors.
PRINT_ERRORS=True

#===========================================================================
# Protocol Detection
#===========================================================================

# Enable protocol identification.
DETECT_TLS=True
DETECT_QUIC=True
DETECT_IPSEC=True
DETECT_HTTP=True
DETECT_DNS=True
DETECT_DHCP=True
DETECT_SSH=True
DETECT_FTP=True
DETECT_SMTP=True
DETECT_NTP=True
DETECT_MQTT=True
DETECT_WEBSOCKET=True

#===========================================================================
# CSV Options
#===========================================================================

# Flush CSV after each packet to reduce data loss.
FLUSH_CSV_AFTER_EACH_PACKET=True

# CSV delimiter.
CSV_DELIMITER=,

#===========================================================================
# Performance
#===========================================================================

# Store raw PCAP.
STORE_PCAP=True

# Store decoded CSV.
STORE_CSV=True

# Store JSON.
STORE_JSON=False

# Enable multi-thread processing.
ENABLE_MULTITHREAD=False

#===========================================================================
# Capture Direction
#===========================================================================

# Determine upload/download direction using LOCAL_IPS.
ENABLE_DIRECTION_ANALYSIS=True

#===========================================================================
# Time Format
#===========================================================================

# Timestamp format.
TIME_FORMAT=%Y-%m-%d %H:%M:%S.%f

#===========================================================================
# AI Traffic Analysis
#===========================================================================

# Calculate packet inter-arrival times.
CALCULATE_INTERARRIVAL=True

# Calculate mean/max idle time and idle periods.
CALCULATE_IDLE_TIME=True

# Calculate flow duration.
CALCULATE_FLOW_DURATION=True

# Calculate burst size.
CALCULATE_BURST_SIZE=True

# Calculate upload/download ratio.
CALCULATE_UPLOAD_DOWNLOAD_RATIO=True

# Calculate packets/sec.
CALCULATE_PACKET_RATE=True

# Calculate throughput (bits/sec).
CALCULATE_BITRATE=True

#===========================================================================
# Packet Statistics
#===========================================================================

CALCULATE_MIN_PACKET_SIZE=True
CALCULATE_MAX_PACKET_SIZE=True
CALCULATE_AVG_PACKET_SIZE=True
CALCULATE_MEDIAN_PACKET_SIZE=True
CALCULATE_STD_PACKET_SIZE=True

#===========================================================================
# Latency
#===========================================================================

# Round Trip Time (when measurable).
CALCULATE_RTT=True

# Packet delay variation.
CALCULATE_JITTER=True

#===========================================================================
# Flow Statistics
#===========================================================================

# Flow expires after this many idle seconds.
FLOW_TIMEOUT=30

# Maximum simultaneous tracked flows.
MAX_ACTIVE_FLOWS=100000

#===========================================================================
# DNS
#===========================================================================

# Resolve IP addresses into host names.
RESOLVE_HOSTNAMES=False

#===========================================================================
# Logging
#===========================================================================

# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Log filename.
LOG_FILE=python_tcpdump.log

#===========================================================================
# Filters
#===========================================================================

# Ignore broadcast traffic.
IGNORE_BROADCAST=True

# Ignore multicast traffic.
IGNORE_MULTICAST=False

# Ignore localhost traffic.
IGNORE_LOOPBACK=True

#===========================================================================
# Export Options
#===========================================================================

# Export overall statistics.
EXPORT_SUMMARY=True

# Export per-flow statistics.
EXPORT_FLOW_SUMMARY=True

# Export protocol distribution.
EXPORT_PROTOCOL_SUMMARY=True

#===========================================================================
# Machine Learning
#===========================================================================

# Enable AI feature extraction.
ENABLE_AI_FEATURES=True

# Export feature vectors suitable for ML training.
EXPORT_AI_FEATURE_VECTOR=True
