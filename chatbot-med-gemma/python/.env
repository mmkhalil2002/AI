OLLAMA_URL=http://10.0.81.181:11434
MEDGEMMA_MODEL=medgemma1.5:latest
# Check-server timeout: 10 seconds
MODEL_LIST_TIMEOUT=10
# MedGemma inference timeout: 900 seconds = 15 minutes
GENERATE_TIMEOUT=900
IMAGE_DIR=data
# resize image to  IMAGE_WIDTH 
XRAY_WIDTH=256
XRAY_HEIGHT=256
EKG_WIDTH=800
EKG_HEIGHT=256
WINDOW_WIDTH=2400
WINDOW_HEIGHT=850
# THINK controls whether Ollama allows the AI model to perform reasoning
# before producing its final answer.
#
# Reasoning means the model internally works through the request step by step.
# For example, when examining an X-ray, EKG, and blood-test results, it may:
#   1. Identify the visible findings.
#   2. Compare the findings with possible medical conditions.
#   3. Check whether the different results agree with each other.
#   4. Organize the findings into a conclusion and final report.
#
# Reasoning is not the final medical report. It is the model's intermediate
# processing used to prepare the answer. It may contain incomplete ideas,
# uncertainty, corrections, or technical model tokens and should normally
# not be displayed to the user.
#
# THINK=false:
# Requests the final answer without extended reasoning output.
# Recommended for this application because it is faster, uses fewer tokens,
# and reduces the possibility of receiving reasoning without a final report.
#
# THINK=true:
# Allows the model to use an extended reasoning stage before the final answer.
# It may help with complicated requests, but it takes longer, uses more tokens,
# and the model could reach NUM_PREDICT before producing the final report.
#
# Accepted values: true/false, yes/no, on/off, or 1/0.
THINK=false  # the current version doesnt support thinking

# NUM_PREDICT is the maximum number of tokens Ollama may generate for one
# response. Tokens are small pieces of words and punctuation used by the model.
#
# A larger value provides more space for reasoning and a detailed final report,
# but it can increase response time and memory usage.
NUM_PREDICT=2024
# Maximum number of seconds the client waits for Ollama to finish one response.
# 900 seconds equals 15 minutes.
# Increase this value if large images or complex reports require more time.
GENERATION_TIMEOUT=1200  # seconds
# Maximum number of tokens MedGemma may generate for one response.
# Larger values allow longer reports but require more time and may increase
# the possibility of repetition.
NUM_PREDICT=2048

# Controls how predictable the generated wording is.
# Lower values produce more focused and consistent reports.
# Higher values produce more varied but less predictable wording.
# Recommended medical-report value: 0.2
TEMPERATURE=0.2

# Discourages MedGemma from repeating words, phrases, and sentences.
# 1.0 means no additional repetition penalty.
# Values above 1.0 apply increasingly stronger repetition prevention.
# A value that is too high may make the report sound unnatural or prevent
# necessary medical terminology from being reused.
# Recommended value: 1.2
REPEAT_PENALTY=1.2

# Number of recently generated tokens examined for repetition.
# With 256, Ollama checks approximately the previous 256 tokens when applying
# REPEAT_PENALTY. A larger value checks a longer portion of the response but
# may discourage legitimate reuse of important medical terminology.
REPEAT_LAST_N=256





#  XRAY download parms 
# Number of pneumonia images to download
XRAY_DIM=True # provide width and height for images
XRAY_IMAGE_COUNT=3

# Folder extension in MMDDYY format
XRAY_FOLDER_EXTENSION=091426

# Final image dimensions  if value is 0 maintain
# the orginal dimension
XRAY_IMAGE_WIDTH=0
#
XRAY_IMAGE_HEIGHT=0

# EKG download settings
EKG_IMAGE_COUNT=10
EKG_FOLDER_EXTENSION=092226

# Use 0 to preserve original dimensions
EKG_IMAGE_WIDTH=0
EKG_IMAGE_HEIGHT=0

# Number of records to save
BLOOD_TEST_RECORD_COUNT=5