# Enable 1-4 cameras in order: Front, Back, Left Side, Right Side.
CAMERA_COUNT=2
# Use auto to discover cameras, or set an explicit device for each position.
FRONT_CAMERA=auto
BACK_CAMERA=auto
LEFT_CAMERA=auto
RIGHT_CAMERA=auto
# Use positive dimensions supported by all enabled cameras, e.g. 640x480 or 1280x720.
# Ubuntu only: set WIDTH=0 and HEIGHT=0 together to select the lowest common resolution.
WIDTH=640
HEIGHT=480
# Requested frame rate: 1-120 FPS. Choose a rate supported by your cameras, e.g. 10, 15, or 30.
FPS=10
# MJPEG (or MJPG) requests compressed capture. AUTO uses automatic format selection.
VIDEO_FORMAT=MJPEG
JPEG_QUALITY=80
# Use 0.0.0.0 for trusted LAN clients and restrict firewall access.
SERVER_HOST=0.0.0.0
SERVER_PORT=14095
CONTROL_PORT=14098
