# WINDOW AND PATIENT-RECORD SECTION DEFINITIONS
#
# WINDOW_SERVER_MAP is a comma-separated table:
#   window-name:server-ID,window-name:server-ID,...
#
# Left side: the name displayed on the record panel and its Zoom/ON-OFF controls.
# It is also the actual section folder name inside each patient's records.
# Names are not predefined: spaces and Unicode are allowed, but the name must
# be a valid single Windows folder name. Do not use commas, colons, slashes,
# backslashes, hidden names starting with a dot, or reserved Windows names.
# Window names must be unique, including when compared without letter case.
#
# Right side: the independent identity of the local MCP server serving that
# section. The ID must exist in SERVER_HANDLERS below. IDs are case-sensitive
# when referenced, must be unique without regard to case, and may contain only
# letters, digits, underscores and hyphens. IDs are not IP addresses or ports.
#
# Example with the current table:
#   patient_records/<patient>/<date>/<time>/xrays/chest.png -> server ID001
# Direct <patient>/xrays and legacy <patient>/data/xrays layouts also work.
# The current dataset uses xrays, ct_scan, ekgs and blood_tests; keep these
# names unless the corresponding record folders use different names.
# Changing a table entry does not rename or move any folders on disk.
#
# Each entry creates one panel, one Zoom control and one ON/OFF control.
# Define between one and four windows, using each server/handler at most once.
# All configured panels start ON. The ON/OFF buttons hide/show them during the
# session; there are no XRAY_ON, CTSCAN_ON, EKG_ON or BLOOD_TEST_ON settings.
# Omitted windows have no controls, load no records and start no MCP server.
#
# Three-window example (CT omitted; retain the SERVER_HANDLERS table below):
# WINDOW_SERVER_MAP=xrays:ID001,ekgs:ID003,blood_tests:ID004
#
# Arbitrary-name example (requires a matching folder named Chest Images):
# WINDOW_SERVER_MAP=Chest Images:ID001
#
# Keep only one active WINDOW_SERVER_MAP assignment. Restart the application
# after editing these tables. OS environment variables with the same names
# override the values in this file.
WINDOW_SERVER_MAP=xrays:ID001,ct_scan:ID002,ekgs:ID003,blood_tests:ID004
#
# MCP SERVER IDENTITIES AND RECORD HANDLERS
#
# SERVER_HANDLERS is a separate comma-separated table:
#   server-ID:record-handler,server-ID:record-handler,...
#
# This table tells the app which existing record handler belongs to each ID.
# Handler names are fixed implementation types, independent of window names:
#   xrays       = X-ray raster images, served by mcp_xray_server.py
#   ct_scan     = CT raster images, served by mcp_ct_scan_server.py
#   ekgs        = EKG/ECG raster images, served by mcp_ekg_server.py
#   blood_tests = blood-test JSON records, served by mcp_blood_server.py
#
# Define all four handlers here, even if WINDOW_SERVER_MAP uses fewer windows.
# Each handler and ID must occur exactly once. Only IDs referenced by active
# windows cause servers to start. Adding a new handler name here does not add
# a new record type to the application.
#
# The server advertises its ID during MCP initialization; the client verifies
# it and routes requests using that identity. Table order does not determine
# which record handler a window uses: the matching server ID does.
# To change ID001 to IMAGES_A, update it in BOTH tables. To rename a window,
# change its left-hand name and use the matching patient-record folder name;
# the server ID and record handler can stay unchanged.
SERVER_HANDLERS=ID001:xrays,ID002:ct_scan,ID003:ekgs,ID004:blood_tests

# Legacy value retained for compatibility with other scripts. The GUI does
# not use OLLAMA_URL to select its inference server. Enter an IP in the GUI
# and press Connect. A blank IP is filled with localhost on Connect, using
# http://localhost:11434; other entries use http://<IP>:11434.
# Success shows green Disconnect; failure shows red Fail and allows retry.
# Disconnect cancels the active local request, closes its response, clears
# the active server/IP and restores yellow Connect. AI requests are blocked
# until another successful Connect. It does not stop the Ollama service.
OLLAMA_URL=http://127.0.0.1:11434
MEDGEMMA_MODEL=medgemma1.5:latest
PATIENT_RECORDS_DIR=..\..\patient_records
# Check-server timeout: 10 seconds
MODEL_LIST_TIMEOUT=10
# MedGemma inference timeout: 900 seconds = 15 minutes
GENERATE_TIMEOUT=3600
IMAGE_DIR=data
#
# resize images
# If these variables are missing, the Python program defaults to 256 × 256 pixels.
# Setting a dimension to 0 preserves that dimension from the original image.
XRAY_WIDTH=256
XRAY_HEIGHT=256
EKG_WIDTH=800
EKG_HEIGHT=256
#
#
WINDOW_WIDTH=2400
WINDOW_HEIGHT=850
# Drive containing the medical-data folders
DISK=E:
# THINK controls whether Ollama allows the AI model to perform reasoning
# before producing its final answer.
#
# Reasoning means the model internally works through the request step by step.
# For example, when examining an X-ray, EKG, and blood-test results, it may:
#   1. Identify the visible findings.
#   2. Compare the findings with possible medical conditions.
#   3. Check whether the different results agree with each other.
#   4. Organize the findings into a conclusion and final report.
#
# Reasoning is not the final medical report. It is the model's intermediate
# processing used to prepare the answer. It may contain incomplete ideas,
# uncertainty, corrections, or technical model tokens and should normally
# not be displayed to the user.
#
# THINK=false:
# Requests the final answer without extended reasoning output.
# Recommended for this application because it is faster, uses fewer tokens,
# and reduces the possibility of receiving reasoning without a final report.
#
# THINK=true:
# Allows the model to use an extended reasoning stage before the final answer.
# It may help with complicated requests, but it takes longer, uses more tokens,
# and the model could reach NUM_PREDICT before producing the final report.
#
# Accepted values: true/false, yes/no, on/off, or 1/0.
# the current version doesn't support THINK=false
THINK=false 

# NUM_PREDICT is the maximum number of tokens Ollama may generate for one
# response. Tokens are small pieces of words and punctuation used by the model.
#
# A larger value provides more space for reasoning and a detailed final report,
# but it can increase response time and memory usage.
NUM_PREDICT=4048
# Maximum number of seconds the client waits for Ollama to finish one response.
# 900 seconds equals 15 minutes.
# Increase this value if large images or complex reports require more time.
GENERATION_TIMEOUT=1200 
# Controls how predictable the generated wording is.
# Lower values produce more focused and consistent reports.
# Higher values produce more varied but less predictable wording.
# Recommended medical-report value: 0.2
TEMPERATURE=0.2

# Discourages MedGemma from repeating words, phrases, and sentences.
# 1.0 means no additional repetition penalty.
# Values above 1.0 apply increasingly stronger repetition prevention.
# A value that is too high may make the report sound unnatural or prevent
# necessary medical terminology from being reused.
# Recommended value: 1.2
REPEAT_PENALTY=1.2

# Number of recently generated tokens examined for repetition.
# With 256, Ollama checks approximately the previous 256 tokens when applying
# REPEAT_PENALTY. A larger value checks a longer portion of the response but
# may discourage legitimate reuse of important medical terminology.
REPEAT_LAST_N=256

