# WINDOW AND MCP SERVER DEFINITIONS
#
# One comma-separated table of window-name:server-ID pairs.
# Default: xrays:ID001,ct_scan:ID002,ekgs:ID003,blood_tests:ID004
#
# Both values in every pair are editable:
# - window-name is the panel/Zoom/ON-OFF name and patient-record section folder.
#   Use any valid single Windows folder name, including spaces and Unicode.
#   It must match the actual folder. Editing this table does not rename files.
#   Do not use commas, colons, slashes, backslashes, hidden or reserved names.
# - server-ID is the independent local MCP identity, verified by the client.
#   Change it here only. Use letters, digits, underscores and hyphens.
#   It is not an IP address, port, folder name or predefined ID.
# Names and IDs must be unique, including without regard to letter case.
#
# With no separate handler table, POSITION selects the existing record handler:
#   1st entry: X-ray images (mcp_xray_server.py)
#   2nd entry: CT images (mcp_ct_scan_server.py)
#   3rd entry: EKG/ECG images (mcp_ekg_server.py)
#   4th entry: blood-test JSON (mcp_blood_server.py)
# Renaming a window or changing its ID does not change its handler.
# Keep positions in this order; reordering pairs changes their handler roles.
#
# Define one to four entries. Three entries create three Zoom controls,
# three ON/OFF controls and three panels for the first three handler positions.
# Omit trailing entries to reduce the count. To include blood tests, keep
# the fourth enabled entry. Enabled panels start ON.
# Syntax: window_name:ON/OFF:ServerID (old name:ID means ON).
# OFF is identical to deleting the entry; later handlers shift forward.
# All OFF shows no record panels and starts no MCP servers.
# Omitted positions load no records and start no local MCP server.
#
# Example changing a name and ID (requires a Chest Images record folder):
# WINDOW_SERVER_MAP=Chest Images:IMAGES_A,ct_scan:ID002,ekgs:ID003,blood_tests:ID004
# Three-window example (first three positions):
# WINDOW_SERVER_MAP=xrays:ID001,ct_scan:ID002,ekgs:ID003
#
# Record path example: <patient>/<date>/<time>/xrays/chest.png -> ID001.
# Direct <patient>/<section> and legacy <patient>/data/<section> also work.
# Restart after edits. OS WINDOW_SERVER_MAP overrides this file.
# Keep one active assignment. There is no second handler table.
WINDOW_SERVER_MAP=xrays:ON:ID001,ct_scan:ON:ID002,ekgs:ON:ID003,blood_tests:ON:ID004

# Patient-search captions. Restart after editing; OS variables override these.
# Missing or blank values use the defaults below. These change labels only.
FIRST_NAME_LABEL=first name
LAST_NAME_LABEL=last name
DOD_LABEL=DOD (MMDDYYYY)

# Legacy value retained for compatibility with other scripts. The GUI does
# not use OLLAMA_URL to select its inference server. Enter an IP in the GUI
# and press Connect. A blank IP is filled with localhost on Connect, using
# http://localhost:11434; other entries use http://<IP>:11434.
# Success shows green Disconnect; failure shows red Fail and allows retry.
# Disconnect cancels the active local request, closes its response, clears
# the active server/IP and restores yellow Connect. AI requests are blocked
# until another successful Connect. It does not stop the Ollama service.
OLLAMA_URL=http://127.0.0.1:11434
MEDGEMMA_MODEL=medgemma1.5:latest
PATIENT_RECORDS_DIR=..\..\patient_records
# Check-server timeout: 10 seconds
MODEL_LIST_TIMEOUT=10
# MedGemma inference timeout: 900 seconds = 15 minutes
GENERATE_TIMEOUT=3600
IMAGE_DIR=data
#
# resize images
# If these variables are missing, the Python program defaults to 256 × 256 pixels.
# Setting a dimension to 0 preserves that dimension from the original image.
XRAY_WIDTH=256
XRAY_HEIGHT=256
EKG_WIDTH=800
EKG_HEIGHT=256
#
#
WINDOW_WIDTH=2400
WINDOW_HEIGHT=850
# Drive containing the medical-data folders
DISK=E:
# THINK controls whether Ollama allows the AI model to perform reasoning
# before producing its final answer.
#
# Reasoning means the model internally works through the request step by step.
# For example, when examining an X-ray, EKG, and blood-test results, it may:
#   1. Identify the visible findings.
#   2. Compare the findings with possible medical conditions.
#   3. Check whether the different results agree with each other.
#   4. Organize the findings into a conclusion and final report.
#
# Reasoning is not the final medical report. It is the model's intermediate
# processing used to prepare the answer. It may contain incomplete ideas,
# uncertainty, corrections, or technical model tokens and should normally
# not be displayed to the user.
#
# THINK=false:
# Requests the final answer without extended reasoning output.
# Recommended for this application because it is faster, uses fewer tokens,
# and reduces the possibility of receiving reasoning without a final report.
#
# THINK=true:
# Allows the model to use an extended reasoning stage before the final answer.
# It may help with complicated requests, but it takes longer, uses more tokens,
# and the model could reach NUM_PREDICT before producing the final report.
#
# Accepted values: true/false, yes/no, on/off, or 1/0.
# the current version doesn't support THINK=false
THINK=false 

# NUM_PREDICT is the maximum number of tokens Ollama may generate for one
# response. Tokens are small pieces of words and punctuation used by the model.
#
# A larger value provides more space for reasoning and a detailed final report,
# but it can increase response time and memory usage.
NUM_PREDICT=4048
# Maximum number of seconds the client waits for Ollama to finish one response.
# 900 seconds equals 15 minutes.
# Increase this value if large images or complex reports require more time.
GENERATION_TIMEOUT=1200 
# Controls how predictable the generated wording is.
# Lower values produce more focused and consistent reports.
# Higher values produce more varied but less predictable wording.
# Recommended medical-report value: 0.2
TEMPERATURE=0.2

# Discourages MedGemma from repeating words, phrases, and sentences.
# 1.0 means no additional repetition penalty.
# Values above 1.0 apply increasingly stronger repetition prevention.
# A value that is too high may make the report sound unnatural or prevent
# necessary medical terminology from being reused.
# Recommended value: 1.2
REPEAT_PENALTY=1.2

# Number of recently generated tokens examined for repetition.
# With 256, Ollama checks approximately the previous 256 tokens when applying
# REPEAT_PENALTY. A larger value checks a longer portion of the response but
# may discourage legitimate reuse of important medical terminology.
REPEAT_LAST_N=256

