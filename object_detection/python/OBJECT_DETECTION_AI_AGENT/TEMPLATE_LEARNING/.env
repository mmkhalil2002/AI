# ============================================================
# DETAILED .ENV CONFIGURATION FILE
# ============================================================
# PURPOSE
# -------
# This file stores configuration values outside the Python code.
#
# Why use a .env file?
#   - You can change paths, training settings, image size, display behavior,
#     and model architecture without editing the Python script.
#   - The Python script reads these values using python-dotenv.
#
# FORMAT RULES
# ------------
# Correct:
#   DEBUG_FLAG=True
#
# Incorrect:
#   DEBUG_FLAG = True
#
# Lines starting with # are comments.
# Boolean values should be True or False.
# Numeric values should be plain numbers.
# ============================================================


# ============================================================
# BASE BASE CONFIGURATION
# ============================================================


# MODEL_BASE
# Main model path used by the Python script to locate the model folder.
# Your script can use it to build:
#   MODEL_FILENAME = os.path.join(MODEL_BASE, "model", ...)
MODEL_BASE=../../../../../


# ============================================================
# DEBUG SETTINGS
# ============================================================

# DEBUG_FLAG
# Controls whether extra diagnostic output is printed.
# False = normal mode with less output.
# True  = debug mode with configuration and OS information.
# Note: your original file had DEBUG_FLAG twice. This cleaned version keeps one.
DEBUG_FLAG=False


# ============================================================
# IMAGE SIZE CONFIGURATION
# ============================================================

# IMAGE_WIDTH
# Width of every image after resizing before entering the CNN.
# Default 32 means CIFAR-style 32x32 input.
IMAGE_WIDTH=32

# IMAGE_HEIGHT
# Height of every image after resizing before entering the CNN.
# Together with IMAGE_WIDTH=32, the model input becomes 32x32.
IMAGE_HEIGHT=32


# ============================================================
# TRAINING PARAMETERS
# ============================================================

# BATCH_SIZE
# Number of training images processed together in one training step.
# Larger = faster if memory allows. Smaller = lower memory usage.
BATCH_SIZE=128

# NUM_EPOCHS
# Number of full passes through the training dataset.
# Higher may improve accuracy but can also overfit.
NUM_EPOCHS=100

# NUM_WORKERS
# Number of subprocesses used by PyTorch DataLoader.
# 0 is safest for Windows and debugging.
# Higher values can improve loading speed on Linux/Ubuntu.
NUM_WORKERS=0


# ============================================================
# INFERENCE PARAMETERS
# ============================================================

# INFER_BATCH_SIZE
# Number of images processed together during inference/testing.
# Larger = faster if memory allows. Smaller = lower memory usage.
INFER_BATCH_SIZE=64


# ============================================================
# MODEL FLAGS
# ============================================================

# STATIC_FILTERS
# False = normal CNN initialization.
# True  = initialize convolution layers with predefined static filters.
# Even when True, layers still learn unless the Python code freezes them.
STATIC_FILTERS=False


# ============================================================
# DISPLAY SETTINGS
# ============================================================

# DISPLAY_TESTED_IMAGE
# True = display tested image during inference.
# False = do not display images. Recommended for headless Ubuntu servers.
DISPLAY_TESTED_IMAGE=True

# ENLARGE_FACTOR
# Magnification factor used only for displaying images.
# Example: 32x32 image with factor 6 displays around 192x192.
ENLARGE_FACTOR=6

# WAIT_FOR_ENTER_BETWEEN_IMAGES
# True = wait for user input between displayed test images.
# False = continue automatically.
WAIT_FOR_ENTER_BETWEEN_IMAGES=True

# DISPLAY_WINDOW_TITLE
# Title used for the display window when images are shown.
DISPLAY_WINDOW_TITLE=Tested Image Viewer


# ============================================================
# CONFIDENCE CONTROL
# ============================================================

# USE_LOW_CONFIDENCE_UNKNOWN_RULE
# False = always use the model top prediction.
# True  = if confidence is below threshold, return unknown label.
USE_LOW_CONFIDENCE_UNKNOWN_RULE=False

# LOW_CONFIDENCE_THRESHOLD
# Confidence cutoff used only when USE_LOW_CONFIDENCE_UNKNOWN_RULE=True.
# Example 0.60 means predictions below 60% confidence become unknown.
LOW_CONFIDENCE_THRESHOLD=0.60

# UNKNOWN_LABEL_BELOW_THRESHOLD
# Label returned when confidence is below LOW_CONFIDENCE_THRESHOLD.
UNKNOWN_LABEL_BELOW_THRESHOLD=unknown


# ============================================================
# TOP-K SETTINGS
# ============================================================

# TOPK_TO_PRINT
# Number of highest-probability predictions to print.
# Example 3 prints the top 3 candidate classes.
TOPK_TO_PRINT=3


# ============================================================
# CNN ARCHITECTURE CONFIGURATION
# ============================================================
# These values must match the model architecture used during training.
# If you change them, old checkpoint files may not load.
# ============================================================

# CONV1_IN_CHANNELS
# Number of input channels to conv1.
# RGB images normally have 3 channels: red, green, blue.
CONV1_IN_CHANNELS=3

# CONV1_OUT_CHANNELS
# Number of feature maps produced by conv1.
# conv1: [B, 3, H, W] -> [B, 128, H, W]
CONV1_OUT_CHANNELS=128

# CONV2_IN_CHANNELS
# Number of input channels to conv2.
# Must equal CONV1_OUT_CHANNELS.
CONV2_IN_CHANNELS=128

# CONV2_OUT_CHANNELS
# Number of feature maps produced by conv2.
# conv2: [B, 128, H/2, W/2] -> [B, 256, H/2, W/2]
CONV2_OUT_CHANNELS=256

# CONV3_IN_CHANNELS
# Number of input channels to conv3.
# Must equal CONV2_OUT_CHANNELS.
CONV3_IN_CHANNELS=256

# CONV3_OUT_CHANNELS
# Number of feature maps produced by conv3.
# conv3: [B, 256, H/2, W/2] -> [B, 512, H/2, W/2]
CONV3_OUT_CHANNELS=512

# CONV4_IN_CHANNELS
# Number of input channels to conv4.
# Must equal CONV3_OUT_CHANNELS.
CONV4_IN_CHANNELS=512

# CONV4_OUT_CHANNELS
# Number of feature maps produced by conv4.
# conv4: [B, 512, H/2, W/2] -> [B, 1024, H/2, W/2]
# This also controls the input size of the final classifier after GAP.
CONV4_OUT_CHANNELS=1024


# ============================================================
# TIME / SYSTEM SETTINGS
# ============================================================

# CLINIC_TZ
# Time zone used by the application when local time is needed.
# Current value is Central Time.
CLINIC_TZ=America/Chicago
